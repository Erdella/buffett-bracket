# Admin login — generate a bcrypt hash of your password and paste it here.
# Easiest way: docker run --rm node:20-slim sh -c "npx -y bcryptjs-cli hash 'your-password'"
# Or in Node: require('bcryptjs').hashSync('your-password', 12)
ADMIN_PASSWORD_HASH=

# Random session secret — used to sign cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Port the server listens on (default 5000)
PORT=5000
NODE_ENV=production

# ---------------------------------------------------------------------------
# Parrothead Madness community voting (magic-link sign-in via Resend)
# ---------------------------------------------------------------------------
# Your Resend API key (https://resend.com). If left blank, the app runs in
# "dev mode": magic links are logged to the server console and surfaced in the
# sign-in dialog instead of being emailed — handy for local testing.
RESEND_API_KEY=

# The From address for sign-in emails. Must be on a domain you've verified in
# Resend. Format: "Display Name <address@yourdomain.com>".
MAIL_FROM=Parrothead Madness <noreply@erdella.com>

# Public base URL of the app, used to build magic-link URLs (no trailing slash).
# e.g. https://buffett.erdella.com . If unset, the request's own origin is used.
APP_BASE_URL=
